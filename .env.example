LLM_PROVIDER=ollama          # "ollama" or "anthropic"
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=           # required only if LLM_PROVIDER=anthropic
DB_PATH=dummy.db
MAX_SQL_ATTEMPTS=3
SCHEMA_DATA_DIR=schema_data

# Safety limits
QUERY_TIMEOUT_MS=3000
MAX_RESULT_ROWS=500
ANSWER_SAMPLE_ROWS=30
# true = show raw errors + attempt history in the web trace (local dev only)
DEBUG_TRACE=false

# Answer quality
SQL_CANDIDATES=3            # 1 = fastest, 3 = majority vote + ambiguity detection
CLARIFY_ON_DISAGREEMENT=true
REFERENCE_DATE=             # empty = today; e.g. 2024-07-15 for reproducible evals
HISTORY_TURNS=3
AUTO_EXPOSE_SCHEMA=false
ROUTER_MAX_TABLES=20
